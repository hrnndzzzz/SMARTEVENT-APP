APP_ENV=development
DATABASE_URL=postgresql://smartevent_server:<password>@<host>:5432/postgres?sslmode=verify-full
JWT_SECRET_KEY=<generate-a-random-secret-of-at-least-32-bytes>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where an approved website download request is pointed. The releases page, not
# one APK, so a link sent months ago still reaches the current build. Left empty,
# approvals are recorded but no email is sent.
APP_DOWNLOAD_URL=

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts
SUPABASE_PROPOSAL_LETTERS_BUCKET=proposal-letters
# Public HTTPS API prefix, including /sap/verify (no trailing token).
SAP_VERIFICATION_BASE_URL=https://api.example.org/sap/verify
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_EMAIL=
OTP_EXPIRY_MINUTES=15
