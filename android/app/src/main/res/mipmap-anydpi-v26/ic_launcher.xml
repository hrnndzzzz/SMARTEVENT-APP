<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 and up masks the launcher tile to whatever shape the
     launcher uses, so the mark is handed over on its own layer and the
     navy is a flat background underneath. The legacy mipmap PNGs stay
     for older phones, which take the square as drawn. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
