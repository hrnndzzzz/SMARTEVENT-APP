<?xml version="1.0" encoding="utf-8"?>
<!-- What the phone shows between the tap and Flutter's first frame.
     The stock file was a blank white rectangle, which reads as a stall;
     the mark on its own navy makes the wait look like the app opening.
     The foreground layer is reused rather than copied so the splash and
     the launcher tile can never drift apart. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
